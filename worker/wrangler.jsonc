{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customer-api",
  "account_id": "d64e67ce2f5262eef1178cd4d08c5380",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The browser terminal (public/index.html), served at /. Requests that
  // match no file fall through to the Worker. The binding is for tests.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customer-api",
      "database_id": "c9ee382c-5ace-414f-b2ba-5dc6f2ef6ea7",
      "migrations_dir": "migrations"
    }
  ],
  // Batch jobs: POST /v1/jobs puts a job on this queue, and the consumer
  // starts a JobRunner workflow for it (see src/jobs.ts).
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "customer-jobs" }],
    "consumers": [{ "queue": "customer-jobs", "max_batch_size": 10, "max_retries": 5 }]
  },
  // The job scheduler: every minute, submit the jobs whose schedule is due
  // (see src/scheduler.ts).
  "triggers": { "crons": ["* * * * *"] },
  "workflows": [
    { "binding": "JOB_RUNNER", "name": "customer-job-runner", "class_name": "JobRunner" }
  ],
  // The system tables: carrier rates, tax codes, help text (src/systables.ts).
  "kv_namespaces": [{ "binding": "TABLES", "id": "5d7e445e101c4f219a4eecd27d3efab3" }],
  // The transaction monitor writes a data point per request (src/monitor.ts).
  // Reading them back needs the AE_API_TOKEN secret (see README).
  "analytics_engine_datasets": [{ "binding": "TXN", "dataset": "customer_transactions" }],
  // The TSO address space: signed-on sessions, record locks, SEND messages
  // and the terminals' WebSockets for live screens (see src/sessions.ts).
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Sessions" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }],
  // Cloudflare Access guards every request; the Worker verifies its JWT.
  // Both values come from the Access application (see README).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "parkerfrank.cloudflareaccess.com",
    "ACCESS_AUD": "c457acd9b4bf7e5a727c091d870ae26ae95747d77cd47c44a55a21ba54997073",
    "CF_ACCOUNT_ID": "d64e67ce2f5262eef1178cd4d08c5380"
  }
}
