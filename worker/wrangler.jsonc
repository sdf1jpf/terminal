{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customer-api",
  "account_id": "d64e67ce2f5262eef1178cd4d08c5380",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customer-api",
      "database_id": "c9ee382c-5ace-414f-b2ba-5dc6f2ef6ea7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SESSION_TTL_HOURS": "8"
  }
  // Users are a secret, not a var: npx wrangler secret put CUSTAPI_USERS
}
