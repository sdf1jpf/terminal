{
  "name": "customer-api-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ACCESS_AUD:",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply customer-api --local",
    "db:migrate:remote": "wrangler d1 migrations apply customer-api --remote",
    "db:seed:local": "wrangler d1 execute customer-api --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute customer-api --remote --file=seed.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "hono": "^4.13.14"
  }
}
